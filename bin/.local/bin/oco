#!/usr/bin/env zsh
set -euo pipefail

REAL_OCO="/opt/homebrew/bin/oco"
MLX_SERVER="/opt/homebrew/bin/mlx_lm.server"
MLX_MODEL="${OCO_MLX_MODEL:-mlx-community/Qwen2.5-Coder-3B-Instruct-4bit}"
MLX_HOST="${OCO_MLX_HOST:-127.0.0.1}"
MLX_PORT="${OCO_MLX_PORT:-8080}"
MLX_URL="http://${MLX_HOST}:${MLX_PORT}/v1/models"
MLX_LOG="${OCO_MLX_LOG:-/tmp/oco-mlx-server.log}"

should_start_mlx=true
case "${1:-}" in
  config|models|setup|hook|commitlint|-h|--help|--version)
    should_start_mlx=false
    ;;
esac

if [[ "${OCO_NO_MLX_SERVER:-}" == "1" ]]; then
  should_start_mlx=false
fi

server_started=false
server_pid=""

server_is_ready() {
  curl -fsS --max-time 1 "$MLX_URL" >/dev/null 2>&1
}

stop_started_server() {
  if [[ "$server_started" == "true" && -n "$server_pid" ]]; then
    kill "$server_pid" >/dev/null 2>&1 || true
    wait "$server_pid" >/dev/null 2>&1 || true
  fi
}

trap stop_started_server EXIT INT TERM

if [[ "$should_start_mlx" == "true" ]] && ! server_is_ready; then
  printf 'Starting MLX server for oco: %s\n' "$MLX_MODEL" >&2
  "$MLX_SERVER" --model "$MLX_MODEL" --host "$MLX_HOST" --port "$MLX_PORT" >"$MLX_LOG" 2>&1 &
  server_pid="$!"
  server_started=true

  for _ in {1..120}; do
    if server_is_ready; then
      break
    fi
    if ! kill -0 "$server_pid" >/dev/null 2>&1; then
      printf 'MLX server exited before becoming ready. Log: %s\n' "$MLX_LOG" >&2
      exit 1
    fi
    sleep 1
  done

  if ! server_is_ready; then
    printf 'MLX server did not become ready within 120s. Log: %s\n' "$MLX_LOG" >&2
    exit 1
  fi
fi

"$REAL_OCO" "$@"
